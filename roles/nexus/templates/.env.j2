# Nexus Repository Manager Environment Configuration
# Generated {{ ansible_date_time.iso8601 }}

# Docker Image
NEXUS_IMAGE={{ nexus_docker_image }}
NEXUS_CONTAINER_NAME={{ nexus_container_name }}

# Port Configuration
NEXUS_HTTP_PORT={{ nexus_docker_port_http }}
NEXUS_HTTPS_PORT={{ nexus_docker_port_https }}
NEXUS_DOCKER_REGISTRY_PORT={{ nexus_docker_port_docker_registry }}

# Storage Configuration
NEXUS_DATA_DIR={{ nexus_docker_data_dir }}

# Network Configuration
NEXUS_DOCKER_NETWORK={{ nexus_docker_network }}

# Security
NEXUS_ADMIN_PASSWORD={{ security.admin_password }}

# Performance Tuning
INSTALL4J_ADD_VM_PARAMS=-Xms512m -Xmx1200m -XX:MaxDirectMemorySize=2g

# Health Check
NEXUS_HEALTHCHECK_ENDPOINT=http://localhost:{{ nexus_docker_port_http }}/service/rest/v1/status
NEXUS_HEALTHCHECK_INTERVAL={{ cicd_contract.health_check_interval }}
NEXUS_HEALTHCHECK_TIMEOUT={{ cicd_contract.readiness_timeout }}

# LDAP Configuration (if enabled)
{% if security.ldap_config.enabled %}
NEXUS_LDAP_ENABLED=true
NEXUS_LDAP_URL={{ security.ldap_config.connection_url }}
NEXUS_LDAP_BASE_DN={{ security.ldap_config.base_dn }}
NEXUS_LDAP_USER_OBJECT_CLASS={{ security.ldap_config.user_object_class }}
NEXUS_LDAP_USER_ID_ATTRIBUTE={{ security.ldap_config.user_id_attribute }}
{% else %}
NEXUS_LDAP_ENABLED=false
{% endif %}

# CMDB Integration (if enabled)
{% if cmdb_integration.enabled %}
NEXUS_CMDB_ENABLED=true
NEXUS_CMDB_URL={{ cmdb_integration.inventory_source }}
NEXUS_CMDB_UPDATE_INTERVAL={{ cmdb_integration.update_interval }}
{% else %}
NEXUS_CMDB_ENABLED=false
{% endif %}

# Prometheus Metrics
NEXUS_PROMETHEUS_ENABLED={{ cicd_contract.supports_prometheus | lower }}
NEXUS_METRICS_ENDPOINT=http://localhost:{{ nexus_docker_port_http }}/service/metrics
