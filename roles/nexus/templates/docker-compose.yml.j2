version: '3.8'

services:
  nexus:
    image: {{ nexus_docker_image }}
    container_name: {{ nexus_container_name }}
    hostname: nexus
    restart: unless-stopped
    networks:
      - {{ nexus_docker_network }}
    ports:
      - "{{ nexus_docker_port_http }}:8081"
      - "{{ nexus_docker_port_https }}:8082"
      - "{{ nexus_docker_port_docker_registry }}:5000"
    environment:
      INSTALL4J_ADD_VM_PARAMS: "-Xms512m -Xmx1200m -XX:MaxDirectMemorySize=2g"
    volumes:
      - nexus-data:{{ nexus_docker_data_dir }}
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:8081/service/rest/v1/status || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

volumes:
  nexus-data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: {{ nexus_docker_data_dir }}

networks:
  {{ nexus_docker_network }}:
    external: true
    driver: bridge
