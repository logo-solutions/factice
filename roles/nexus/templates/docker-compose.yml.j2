services:
  nexus:
    image: {{ nexus_docker_image }}
    container_name: {{ nexus_container_name }}
    hostname: nexus
    restart: unless-stopped
    networks:
      - {{ nexus_docker_network }}
    ports:
      - "{{ nexus_docker_port_http }}:8081"
{% for repo, port in nexus_docker_connectors.items() %}
      - "{{ port }}:{{ port }}"
{% endfor %}
    environment:
      INSTALL4J_ADD_VM_PARAMS: "{{ nexus_jvm_params }}"
    volumes:
      - {{ nexus_data_dir }}:/nexus-data
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:8081/service/rest/v1/status || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

networks:
  {{ nexus_docker_network }}:
    external: true
