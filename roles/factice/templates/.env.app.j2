# Factice Application Environment Configuration
# Generated: {{ ansible_date_time.iso8601 }}
# Environment: {{ factice_environment }}

# Application
NODE_ENV={{ factice_app_env.NODE_ENV }}
PORT={{ factice_app_env.PORT }}
API_URL={{ factice_app_env.API_URL }}
LOG_LEVEL={{ factice_app_env.LOG_LEVEL }}

# Database Connection
DATABASE_URL={{ factice_app_env.DATABASE_URL }}
DB_HOST={{ tier_db_host_from_app }}
DB_PORT={{ tier_db_port }}
DB_NAME={{ tier_db_name }}
DB_USER={{ tier_db_user }}
DB_PASSWORD={{ tier_db_password }}
DB_POOL_SIZE={{ tier_db_pool_size }}

# Docker
DOCKER_NETWORK={{ factice_docker_network }}
DOCKER_CONTAINER_NAME={{ tier_app_container_name }}

# Healthcheck
HEALTHCHECK_ENDPOINT={{ tier_app_healthcheck_endpoint }}
HEALTHCHECK_INTERVAL=30

# Web Server
WEB_HOSTNAME={{ tier_web_hostname }}
WEB_PORT_HTTP={{ tier_web_port_http }}

# Logging
LOG_DIR={{ factice_logs_dir }}
LOG_FORMAT=json
LOG_LEVEL={{ factice_app_env.LOG_LEVEL }}

# Monitoring
METRICS_ENABLED={{ factice_metrics_enabled | lower }}

# Feature Flags
ENVIRONMENT={{ factice_environment }}
DEBUG={{ 'true' if factice_environment == 'integration' else 'false' }}
