# Reverse proxy factice, environnement {{ factice_environment }}
# Fichier géré par Ansible : ne pas modifier à la main.

{
	admin off
	auto_https off
	log {
		format json
		level {{ 'DEBUG' if factice_environment == 'integration' else 'INFO' }}
	}
}

http://:{{ tier_web_port_http }} {
{% if tier_web_access_logs_enabled | bool %}
	log {
		format json
		output file {{ factice_logs_dir }}/caddy-access.log {
			roll_size 100MiB
			roll_keep 3
			roll_keep_for 720h
		}
	}
{% endif %}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode gzip

	reverse_proxy localhost:{{ tier_app_port_http }} {
		health_uri /health
		health_interval 30s
		header_up X-Real-IP {remote_host}
	}
}
